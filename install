#dmesg | grep -i usb
#dmesg | grep -i network
#dmesg -c (limpar o buffer)
#journalctl -b -u dhcpd.service
#journalctl -b 

Fazer download de pacotes deb:
#apt install nomepacote –download-only
Salvos em: /var/cache/apt/archives
Instalar: dpkg -i nome/pacote

Fazer pen drive bootável:
Com iso:
dd if=/arquivo.iso of=/dev/sdb status=progress
Arrumar o pen-drive com o fdisk
Com disco-virtual:
fallocate -l 8G disco-virtual
losetup /dev/loop0 -P disco-virtual
Instalar o debian em /dev/loop0
losetup -d /dev/loop0
dd if=disco-virtual of=/dev/sdb bs=16M oflag=sync status=progress
Arrumar o pen-drive com o fdisk

