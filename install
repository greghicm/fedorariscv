Repositórios Debian Trixie em /etc/apt/sources.list.d/debian.sources:
# Modernized from /etc/apt/sources.list
Types: deb deb-src
URIs: http://ftp.br.debian.org/debian/
Suites: trixie
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

# Repositório de Atualizações (updates) para Trixie
Types: deb deb-src
URIs: http://ftp.br.debian.org/debian/
Suites: trixie-updates
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

# Repositório de Segurança para Trixie
# (Lembre-se da observação: Para testing, as atualizações de segurança chegam via unstable,
# mas esta entrada é boa para quando trixie se tornar stable ou para pacotes específicos.)
Types: deb deb-src
URIs: http://ftp.br.debian.org/debian-security/
Suites: trixie-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

# Repositório de Backports para Trixie (Opcional, para software mais recente)
Types: deb deb-src
URIs: http://ftp.br.debian.org/debian/
Suites: trixie-backports
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

