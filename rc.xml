<labwc_config>
<theme><name>Clia</name><cornerRadius>1</cornerRadius><font name="IBM Plex Mono" size="12" /></theme>
<keyboard>
<default />
<keybind key="W-Return"><action name="Execute" command="foot"/></keybind>
<keybind key="W-g"><action name="Execute" command="google-chrome"/></keybind>
<keybind key="W-p"><action name="Execute" command="pavucontrol"/></keybind>
<keybind key="W-Space"><action name="ShowMenu" menu="root-menu"/></keybind>
<keybind key="W-Backspace"><action name="Togglemaximize"/></keybind>
<keybind key="W-\"><action name="Iconify"/></keybind>
<keybind key="W-f"><action name="ToggleFullscreen"/></keybind>
<keybind key="W-q"><action name="Close"/></keybind>
</keyboard>
<mouse>
<default />
<context name="Root">
<mousebind button="Right" action="Press"><action name="ShowMenu" menu="root-menu"/></mousebind>
</context>
</mouse>
<windowSwitcher show="yes" preview="yes" outlines="no" allWorkspaces="no">
<fields>
<field content="desktop_entry_name" width="80%" />
<field content="state" width="10%" />
<field content="type_short" width="10%"/>
</fields>
</windowSwitcher>
</labwc_config>
